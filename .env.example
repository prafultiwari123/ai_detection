# The Hugging Face Hub id of YOUR fine-tuned model, exported to ONNX
# (see README.md -> "1. Convert your model to ONNX").
HF_MODEL_ID=praful1/roberta-ai-detector-onnx

# fp32 | fp16 | q8 | q4  -- must match a weight file that actually exists
# in your ONNX export. q8 is a good default for a RoBERTa-base sized model.
MODEL_DTYPE=fp32

# Only needed if your model's id2label in config.json doesn't contain a
# recognizable word like "ai"/"generated"/"machine". Set this to whichever
# label index in your config.json means "AI-written" (0 or 1).
AI_LABEL_INDEX=1
